#!/bin/sh

# Define colors (optional)
FG="#ffffff"
BG="#282a2e"

# Function to get workspaces
get_workspaces() {
    bspc subscribe desktop_focus | while read -r line; do
        # Parse bspwm status and format for lemonbar
        # This will involve extracting workspace names and their states (focused, occupied, etc.)
        # and formatting them with lemonbar's formatting codes (e.g., %{F#color}text%{F-})
        echo "1:A 2:B 3:C" # Placeholder for actual workspace output
    done
}

# Function to get time
get_time() {
    while true; do
        date "+%H:%M"
        sleep 1
    done
}

# Pipe output to lemonbar
{
    get_workspaces &
    get_time &
} | lemonbar -p -g xMM+x+x -F "$FG" -B "$BG"
